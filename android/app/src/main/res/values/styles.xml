<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediTime" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_600</item>
        <item name="colorPrimaryDark">@color/primary_700</item>
        <item name="colorAccent">@color/mint_500</item>
        <item name="android:statusBarColor">@color/primary_700</item>
    </style>

    <style name="Theme.MediTime.NoActionBarLaunch" parent="Theme.MediTime">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.MediTime.AlarmScreen" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
    </style>
</resources>
